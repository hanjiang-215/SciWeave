# Copy to the deployment directory and fill values locally.
# Subscriber identity. SCIWEAVE_AGENT_ID is required by gateway/subscriber and by
# the worker shell; it also selects the Agent definition the worker runs, so it
# must match an `agents.<name>` key under AGENT_DEFINITIONS_PATH.
# SCIWEAVE_SUBSCRIBER_TOPICS is a comma-separated topic list.
# These defaults let the subscriber start unchanged; rename both when you deploy
# under your own agent id.
SCIWEAVE_AGENT_ID=researcher-task-agent
SCIWEAVE_SUBSCRIBER_TOPICS=sciweave.task-handoff.researcher-task-agent
QUEUE_URL=
QUEUE_CONSUMER_GROUP=
# Durable inbox: leave empty to keep the in-memory demo path.
DATABASE_PATH=
WORKER_HOME=
DOMAIN_MCP_URL=
# Configuration roots. Leave them all empty to use the directories shipped with
# the kit; a relative path is resolved against the working directory, so prefer
# absolute ones. The worker loads all four at startup and refuses to start when
# one is missing or invalid.

# Shipped packs.
AGENT_DEFINITIONS_PATH=
AGENT_LIBS_PATH=
MCP_LIBS_PATH=
WORKFLOW_LIBS_PATH=

# Your own overrides. LOCAL_AGENT_DEFINITIONS_PATH is an *additional* directory:
# it adds agents, and a name the shipped directory already declares is an error
# rather than a silent shadow. The other three are override pairs.
LOCAL_AGENT_DEFINITIONS_PATH=
LOCAL_AGENT_LIBS=
LOCAL_MCP_LIBS=
LOCAL_WORKFLOW_LIBS_PATH=

# Skills. A directory of `<skill>/SKILL.md`; SCIWEAVE_SKILLS_PATH takes several
# separated by `:` (the same shape as PATH) and is loaded first, LOCAL_SKILLS_PATH
# last, so a local skill of the same name wins. Both default to *empty* — the
# worker then runs with no skills at all. That is deliberate, twice over:
# fast-agent would otherwise scan `~/.fast-agent/skills`, and the kit's own
# `deploy-task-agent-skills/` are instructions for the researcher's personal
# Agent (how to deploy and configure this kit), not for the worker's own model
# loop. A wrong path stops the worker at startup instead of silently loading
# nothing.
SCIWEAVE_SKILLS_PATH=
LOCAL_SKILLS_PATH=

# Central draft box (Streamable HTTP create_draft). Read by the Worker only; the
# subscriber never holds these credentials. Leave both empty to use the fake
# draft box for local demos/tests. SCIWEAVE_DRAFT_NAMESPACE selects the domain
# namespace (mapping | wiki).
DRAFT_BUFFER_MCP_URL=
DRAFT_BUFFER_MCP_TOKEN=
SCIWEAVE_DRAFT_NAMESPACE=
RESEARCH_MAPPING_MCP_URL=
RESEARCH_MAPPING_MCP_TOKEN=
LLM_WIKI_MCP_URL=
LLM_WIKI_MCP_TOKEN=
# Central notification service. EMAIL_MCP_URL must point at the /mcp path of
# the email-service Streamable HTTP endpoint; EMAIL_MCP_TOKEN is one entry of
# that service's own SCIWEAVE_EMAIL_TOKENS_JSON map, bound to this researcher.
EMAIL_MCP_URL=
EMAIL_MCP_TOKEN=

# Worker dispatch (ai4-0fwc). The subscriber starts one short-lived worker
# process per handoff and holds the Worker Lease while it runs; the worker owns
# the model credential and the draft box. Set SCIWEAVE_WORKER_DISPATCH=0 to run
# the two roles as separate services instead (the subscriber then leaves
# handoffs queued). WORKER_COMMAND overrides the command that is started; it is
# a JSON list or a whitespace-split string, defaulting to this interpreter plus
# service-template/worker/src/main.py.
SCIWEAVE_WORKER_DISPATCH=1
SCIWEAVE_WORKER_COMMAND=
SCIWEAVE_WORKER_TIMEOUT_SECONDS=1800

# Worker runtime (ai4-g1km). The real runtime needs a key; passthrough is only
# reachable with SCIWEAVE_GATEWAY_PASSTHROUGH_RUNTIME=1 and is for local checks.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SCIWEAVE_FAST_AGENT_HOME=
SCIWEAVE_FAST_AGENT_SESSION_DIR=sessions
SCIWEAVE_WORKER_CONNECTION_SCOPE=local
SCIWEAVE_WORKER_BATCH=1
SCIWEAVE_GATEWAY_PASSTHROUGH_RUNTIME=0
# Which workflow the worker runs (ai4-x0ay). Empty means "the one workflow this
# configuration declares"; a kit that ships several examples needs a name here,
# otherwise the worker stays on the single-agent path. The shipped preset:
#   SCIWEAVE_WORKFLOW=literature-agent
SCIWEAVE_WORKFLOW=

# Disposition MCP (gateway/mcp role).
DISPOSITION_MCP_HOST=127.0.0.1
DISPOSITION_MCP_PORT=8790
DISPOSITION_MCP_TOKEN=

# SciencePal execution bridge (custom-mcp/sciencepal-bridge). The bridge reads
# its own .env; these names document the kit-level variables and the stdio
# project directory used by libs/mcp-libs/sciencepal/mcp.json.
SCIENCEPAL_BRIDGE_DIR=
SCIENCEPAL_ACCESS_TOKEN=
SCIENCEPAL_BASE_URL=https://sciencepal.ai/api
SCIENCEPAL_WORKSPACE=
SCIENCEPAL_RUN_DB=
SCIENCEPAL_MAX_UPLOAD_MB=25
SCIENCEPAL_DEFAULT_AGENT_ID=

# Literature search MCP (custom-mcp/literature-search). Both sources are public
# and need no key, so these have working defaults. The project directory is what
# libs/mcp-libs/literature-search/mcp.json passes to the stdio startup.
LITERATURE_MCP_PROJECT_DIR=
LITERATURE_ARXIV_ENDPOINT=https://export.arxiv.org/api/query
LITERATURE_CROSSREF_ENDPOINT=https://api.crossref.org/works
# Crossref asks for a contact address in the User-Agent; leave empty to omit it.
LITERATURE_CONTACT_EMAIL=
LITERATURE_TIMEOUT_SECONDS=10
