# Copy to the deployment directory and fill values locally.
QUEUE_URL=
QUEUE_CONSUMER_GROUP=
# Durable inbox: leave empty to keep the in-memory demo path.
DATABASE_PATH=
WORKER_HOME=
DOMAIN_MCP_URL=
# Central draft box (Streamable HTTP create_draft). Leave both empty to use the
# fake draft box for local demos/tests. SCIWEAVE_DRAFT_NAMESPACE selects the
# domain namespace (mapping | wiki).
DRAFT_BUFFER_MCP_URL=
DRAFT_BUFFER_MCP_TOKEN=
SCIWEAVE_DRAFT_NAMESPACE=
LOCAL_MCP_LIBS=
RESEARCH_MAPPING_MCP_URL=
RESEARCH_MAPPING_MCP_TOKEN=
LLM_WIKI_MCP_URL=
LLM_WIKI_MCP_TOKEN=
DRAFT_BUFFER_MCP_TOKEN=
# Central notification service. EMAIL_MCP_URL must point at the /mcp path of
# the email-service Streamable HTTP endpoint; EMAIL_MCP_TOKEN is one entry of
# that service's own SCIWEAVE_EMAIL_TOKENS_JSON map, bound to this researcher.
EMAIL_MCP_URL=
EMAIL_MCP_TOKEN=

# Worker runtime (ai4-g1km). The real runtime needs a key; passthrough is only
# reachable with SCIWEAVE_GATEWAY_PASSTHROUGH_RUNTIME=1 and is for local checks.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SCIWEAVE_FAST_AGENT_HOME=
SCIWEAVE_FAST_AGENT_SESSION_DIR=sessions
SCIWEAVE_WORKER_CONNECTION_SCOPE=local
SCIWEAVE_WORKER_BATCH=1
SCIWEAVE_GATEWAY_PASSTHROUGH_RUNTIME=0
# Disposition MCP (gateway/mcp role).
DISPOSITION_MCP_HOST=127.0.0.1
DISPOSITION_MCP_PORT=8790
DISPOSITION_MCP_TOKEN=