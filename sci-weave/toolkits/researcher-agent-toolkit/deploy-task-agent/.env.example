# Copy to the deployment directory and fill values locally.
# Subscriber identity. SCIWEAVE_AGENT_ID is required by gateway/subscriber and by
# the worker shell; SCIWEAVE_SUBSCRIBER_TOPICS is a comma-separated topic list.
SCIWEAVE_AGENT_ID=
SCIWEAVE_SUBSCRIBER_TOPICS=sciweave.task-handoff.<your-agent-id>
QUEUE_URL=
QUEUE_CONSUMER_GROUP=
# Durable inbox: leave empty to keep the in-memory demo path.
DATABASE_PATH=
WORKER_HOME=
DOMAIN_MCP_URL=
# Library roots. Leave all six empty to use the directories relative to the kit.
# *_LIBS_PATH points at the shipped pack; LOCAL_* points at your own overrides,
# which win over a standard definition with the same name.
AGENT_LIBS_PATH=
MCP_LIBS_PATH=
WORKFLOW_LIBS_PATH=
LOCAL_AGENT_LIBS=
LOCAL_MCP_LIBS=
LOCAL_WORKFLOW_LIBS_PATH=
# Central draft box (Streamable HTTP create_draft). Read by the Worker only; the
# subscriber never holds these credentials. Leave both empty to use the fake
# draft box for local demos/tests. SCIWEAVE_DRAFT_NAMESPACE selects the domain
# namespace (mapping | wiki).
DRAFT_BUFFER_MCP_URL=
DRAFT_BUFFER_MCP_TOKEN=
SCIWEAVE_DRAFT_NAMESPACE=
RESEARCH_MAPPING_MCP_URL=
RESEARCH_MAPPING_MCP_TOKEN=
LLM_WIKI_MCP_URL=
LLM_WIKI_MCP_TOKEN=
# Central notification service. EMAIL_MCP_URL must point at the /mcp path of
# the email-service Streamable HTTP endpoint; EMAIL_MCP_TOKEN is one entry of
# that service's own SCIWEAVE_EMAIL_TOKENS_JSON map, bound to this researcher.
EMAIL_MCP_URL=
EMAIL_MCP_TOKEN=

# Worker runtime (ai4-g1km). The real runtime needs a key; passthrough is only
# reachable with SCIWEAVE_GATEWAY_PASSTHROUGH_RUNTIME=1 and is for local checks.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SCIWEAVE_FAST_AGENT_HOME=
SCIWEAVE_FAST_AGENT_SESSION_DIR=sessions
SCIWEAVE_WORKER_CONNECTION_SCOPE=local
SCIWEAVE_WORKER_BATCH=1
SCIWEAVE_GATEWAY_PASSTHROUGH_RUNTIME=0
# Disposition MCP (gateway/mcp role).
DISPOSITION_MCP_HOST=127.0.0.1
DISPOSITION_MCP_PORT=8790
DISPOSITION_MCP_TOKEN=

# SciencePal execution bridge (custom-mcp/sciencepal-bridge). The bridge reads
# its own .env; these names document the kit-level variables and the stdio
# project directory used by libs/mcp-libs/sciencepal/mcp.json.
SCIENCEPAL_BRIDGE_DIR=
SCIENCEPAL_ACCESS_TOKEN=
SCIENCEPAL_BASE_URL=https://sciencepal.ai/api
SCIENCEPAL_WORKSPACE=
SCIENCEPAL_RUN_DB=
SCIENCEPAL_MAX_UPLOAD_MB=25
SCIENCEPAL_DEFAULT_AGENT_ID=