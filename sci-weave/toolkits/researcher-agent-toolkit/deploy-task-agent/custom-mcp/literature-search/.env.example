# Copy to .env and adjust locally. Both sources are public and need no key.
#
# Upstream endpoints are overridable so tests and air-gapped deployments can
# point at a mirror; leave them empty to use the public ones.
LITERATURE_ARXIV_ENDPOINT=https://export.arxiv.org/api/query
LITERATURE_CROSSREF_ENDPOINT=https://api.crossref.org/works
# Sent in the User-Agent of every request. Crossref asks for a contact address
# here; without one it still answers, but a real address is the polite default
# and lets them reach you instead of blocking the IP.
LITERATURE_CONTACT_EMAIL=
LITERATURE_TIMEOUT_SECONDS=10
