# Copy to .env and fill values locally. Never commit the real token.
SCIENCEPAL_ACCESS_TOKEN=
SCIENCEPAL_BASE_URL=https://sciencepal.ai/api
# Leave empty to use ~/.sciweave/sciencepal-workspace. A relative path resolves
# against the process working directory, so an absolute path is safer when the
# harness starts the bridge from an arbitrary directory.
SCIENCEPAL_WORKSPACE=
SCIENCEPAL_RUN_DB=
SCIENCEPAL_MAX_UPLOAD_MB=25
SCIENCEPAL_DEFAULT_AGENT_ID=
