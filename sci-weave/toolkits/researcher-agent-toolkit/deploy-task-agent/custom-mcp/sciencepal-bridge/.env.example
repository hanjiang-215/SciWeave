# Copy to .env and fill values locally. Never commit the real token.
SCIENCEPAL_ACCESS_TOKEN=
SCIENCEPAL_BASE_URL=https://sciencepal.ai/api
# Leave empty to use ~/.sciweave/sciencepal-workspace. A relative path resolves
# against the process working directory, so an absolute path is safer when the
# harness starts the bridge from an arbitrary directory.
SCIENCEPAL_WORKSPACE=
SCIENCEPAL_RUN_DB=
SCIENCEPAL_MAX_UPLOAD_MB=25
SCIENCEPAL_DEFAULT_AGENT_ID=

# ai4-roow: ExecutionReport write-back into the central draft buffer.
# The bridge only opens mapping drafts (namespace=mapping, kind=mapping_change);
# it never submits candidates or formalizes a revision.
SCIWEAVE_DRAFT_BUFFER_URL=
# Token of the harness identity. The draft buffer injects the caller identity
# from this bearer token; entitlements stay there, not in this file.
SCIWEAVE_DRAFT_BUFFER_TOKEN=
# Optional display id recorded as the draft submitter.
SCIWEAVE_BRIDGE_SUBMITTED_BY=sciencepal-bridge
