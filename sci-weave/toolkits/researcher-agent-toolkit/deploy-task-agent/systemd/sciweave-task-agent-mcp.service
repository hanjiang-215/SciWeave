# NOT IMPLEMENTED (ai4-58d0): the disposition tools in docs/data-flow/work-agent.md
# have no handler yet; start-mcp fails fast on purpose. Do not enable this unit.

[Unit]
Description=SciWeave researcher-owned Work Agent MCP gateway
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.sciweave/task-agent
EnvironmentFile=%h/.sciweave/task-agent/.env
ExecStart=%h/.sciweave/task-agent/bin/start-mcp
Restart=on-failure

[Install]
WantedBy=default.target
