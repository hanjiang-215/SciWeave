# Project Owner 套件的运行配置
#
# 负责人自己的机器上只有 harness，没有常驻服务：这里全是 MCP 地址与令牌。
# 真实值放进 harness 的环境或 ~/.sciweave/owner/.env，仓库只提交本文件。

# ── 领域管理 MCP：裁决与正式化的入口 ─────────────────────────────────
RESEARCH_MAPPING_MCP_URL=http://127.0.0.1:8710/mcp
RESEARCH_MAPPING_MCP_TOKEN=replace-with-owner-token
LLM_WIKI_MCP_URL=http://127.0.0.1:8720/mcp
LLM_WIKI_MCP_TOKEN=replace-with-owner-token

# ── 协调服务：派发根任务 ─────────────────────────────────────────────
# 根节点不会随正式版本发布自动派发，只从这里开始。
SCIWEAVE_COORDINATOR_MCP_URL=http://127.0.0.1:8090/mcp
SCIWEAVE_COORDINATOR_MCP_TOKEN=replace-with-coordinator-token

# ── 注册表：人、Agent 与实例 ─────────────────────────────────────────
# 令牌身份必须是 caller_type=project_owner，否则 register_principal 与
# get_principal_contact 一律 denied。
SCIWEAVE_REGISTRY_URL=http://127.0.0.1:8701/mcp
SCIWEAVE_REGISTRY_TOKEN=replace-with-owner-token

# ── 通知服务：候选退回/驳回 ──────────────────────────────────────────
EMAIL_MCP_URL=http://127.0.0.1:8702/mcp
EMAIL_MCP_TOKEN=replace-with-owner-token
