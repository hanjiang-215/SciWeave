[Unit]
Description=SciWeave Centre Agent governance-event ingest (candidate events -> prereview)
After=network-online.target
Wants=network-online.target
# The domain management MCP is the only write target. Starting before it is up
# is survivable — the consumer raises, the offset stays uncommitted and the
# record replays — but it logs a failure per event, so order against the unit
# when both live on this host.
After=sciweave-mapping-mcp.service sciweave-wiki-mcp.service

[Service]
Type=simple
# The suite does not ship the centre source: the server already has a checkout
# (ADR-0002 keeps the two work-agent codebases apart). The start script reads
# SCIWEAVE_CENTRE_AGENTS_HOME from .env and runs there.
WorkingDirectory=%h/.sciweave/centre
EnvironmentFile=%h/.sciweave/centre/.env
ExecStart=%h/.sciweave/centre/bin/start-ingest
Restart=on-failure
# Offsets are committed per record, so a restart replays at most the record that
# was in flight. Restarting faster than that is pointless and would hot-loop
# against a domain MCP that is down.
RestartSec=5s

[Install]
WantedBy=default.target
