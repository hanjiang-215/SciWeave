# Centre Agent 套件的运行配置
#
# 真实值放进 SCIWEAVE_CENTRE_SUITE_HOME/.env，由 systemd unit 的
# EnvironmentFile 注入；仓库只提交本文件。两个进程角色（ingest、mcp）
# 共用这一份，因为它们必须看到同一个执行库。

# ── 中央 Agent 的代码位置 ─────────────────────────────────────────────
# 本套件不打包中央服务的源码：中央服务器上本来就有一份检出。
# install.sh 会校验这个目录里有 centre-agents/pyproject.toml。
SCIWEAVE_CENTRE_AGENTS_HOME=/opt/sciweave/centre-control/centre-agents

# ── ingest：治理事件 → 领域管理 MCP ───────────────────────────────────
# 消费者组必须与其它 Work Agent 不同，否则会互相抢事件。
SCIWEAVE_QUEUE_GROUP_ID=sciweave.centre-workflow.centre-1
# 候选事件与正式版本发布事件走同一个 topic（ai4-te1v）。
SCIWEAVE_SUBSCRIBER_TOPICS=sciweave.governance-events
# 留空则退回 FakeQueue：只在本地演示/测试时这样做。
SCIWEAVE_QUEUE_BOOTSTRAP_SERVERS=127.0.0.1:19092
# ingest 自己记录已处理事件的去重库，与执行库不是同一份。
SCIWEAVE_INGEST_DB=$HOME/.sciweave/centre/ingest.sqlite3

# ── 领域管理 MCP：ingest 唯一的写入口 ────────────────────────────────
# 注意：ingest 目前对单个域工作（一个 SCIWEAVE_DOMAIN_MCP_URL）。
# Mapping 与 Wiki 各起一份 ingest，用不同的消费者组与 topic 前缀区分。
SCIWEAVE_DOMAIN_MCP_URL=http://127.0.0.1:8710/mcp
SCIWEAVE_DOMAIN_MCP_TOKEN=replace-with-centre-capability-token

# ── 处置面（mcp 角色）：给运维/负责人观察与处置中央执行 ──────────────
SCIWEAVE_GATEWAY_DB=$HOME/.sciweave/centre/gateway.sqlite3
SCIWEAVE_GATEWAY_TOKEN=replace-with-disposition-token
SCIWEAVE_GATEWAY_CALLER_ID=centre-agent-1
SCIWEAVE_GATEWAY_HOST=127.0.0.1
SCIWEAVE_GATEWAY_PORT=8711
# Worker 的执行目录；connection_scope 必填，否则执行永远停在 queued。
SCIWEAVE_WORKER_HOME=$HOME/.sciweave/centre/worker-home
SCIWEAVE_WORKER_SESSION_DIR=sessions
SCIWEAVE_WORKER_CONNECTION_SCOPE=centre-agent-local
SCIWEAVE_WORKER_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# ── 预审判据 ─────────────────────────────────────────────────────────
# 领域 MCP 侧解析 <version>.json 的目录；套件不复制规则文件，
# 规则的版本化归仓库 Git。
SCIWEAVE_MAPPING_PREREVIEW_RULES_DIR=
SCIWEAVE_WIKI_PREREVIEW_RULES_DIR=

# ── 套件自检用的位置 ─────────────────────────────────────────────────
SCIWEAVE_CENTRE_SKILLS_HOME=$HOME/.sciweave/centre-skills
SCIWEAVE_PREREVIEW_SWEEP_MAX_AGE_SECONDS=1800
