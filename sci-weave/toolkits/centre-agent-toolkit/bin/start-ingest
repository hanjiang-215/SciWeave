#!/usr/bin/env sh
# Entry point referenced by systemd/sciweave-centre-agent-ingest.service.
#
# The suite ships the *configuration*, not the centre source: the central
# server already has a checkout, and ADR-0002 keeps the two work-agent
# codebases apart rather than sharing one runtime. So this script locates that
# checkout (SCIWEAVE_CENTRE_AGENTS_HOME), verifies it is the ingest package's
# workspace, and runs the console script there.
#
# Failing here is better than starting a consumer that silently reads nothing:
# an ingest with the wrong group id looks alive in systemd while every
# governance event stays unconsumed.
set -eu

SUITE="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$SUITE"

if [ ! -f "$SUITE/.env" ]; then
  echo "missing $SUITE/.env; copy .env.example and fill it in" >&2
  exit 78
fi

AGENTS_HOME="${SCIWEAVE_CENTRE_AGENTS_HOME:-}"
if [ -z "$AGENTS_HOME" ]; then
  # The .env is the only configuration surface; read it here because systemd's
  # EnvironmentFile does not export variables to a shell that re-reads .env.
  # shellcheck disable=SC1090
  . "$SUITE/.env"
  AGENTS_HOME="${SCIWEAVE_CENTRE_AGENTS_HOME:-}"
fi
if [ -z "$AGENTS_HOME" ] || [ ! -f "$AGENTS_HOME/pyproject.toml" ]; then
  echo "SCIWEAVE_CENTRE_AGENTS_HOME must point at the centre-agents checkout (no pyproject.toml at '${AGENTS_HOME:-<unset>}')" >&2
  exit 78
fi

exec uv run --project "$AGENTS_HOME" --env-file "$SUITE/.env" \
  sciweave-task-agent-gateway-ingest
