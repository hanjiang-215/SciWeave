#!/usr/bin/env sh
# Entry point referenced by systemd/sciweave-centre-agent-mcp.service.
#
# Same shape as bin/start-ingest: locate the centre-agents checkout, run its
# console script inside that workspace environment. The disposition MCP fails
# fast on its own when SCIWEAVE_GATEWAY_DB or SCIWEAVE_GATEWAY_TOKEN is missing,
# so this script does not duplicate those checks.
#
# The MCP role binds a host/port. It is a *disposition* surface for a human
# watching the centre, not a domain service: it must not be exposed beyond the
# operator's own network, which is why the default in .env.example is loopback.
set -eu

SUITE="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$SUITE"

if [ ! -f "$SUITE/.env" ]; then
  echo "missing $SUITE/.env; copy .env.example and fill it in" >&2
  exit 78
fi

AGENTS_HOME="${SCIWEAVE_CENTRE_AGENTS_HOME:-}"
if [ -z "$AGENTS_HOME" ]; then
  # shellcheck disable=SC1090
  . "$SUITE/.env"
  AGENTS_HOME="${SCIWEAVE_CENTRE_AGENTS_HOME:-}"
fi
if [ -z "$AGENTS_HOME" ] || [ ! -f "$AGENTS_HOME/pyproject.toml" ]; then
  echo "SCIWEAVE_CENTRE_AGENTS_HOME must point at the centre-agents checkout (no pyproject.toml at '${AGENTS_HOME:-<unset>}')" >&2
  exit 78
fi

exec uv run --project "$AGENTS_HOME" --env-file "$SUITE/.env" \
  sciweave-task-agent-gateway-mcp
