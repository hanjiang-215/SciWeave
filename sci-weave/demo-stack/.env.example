# 演示链路编排的环境变量样例。复制为 .env 后按需修改；.env 不入库。
#
# TerminusDB 是第三方服务，按 sci-weave/service/terminusdb/compose.yaml 单独起；
# 本栈通过 host.docker.internal 访问宿主机上的它。

# 宿主机暴露端口（浏览器与本地脚本用）
MAPPING_HOST_PORT=8701
DASHBOARD_HOST_PORT=8702
WEB_HOST_PORT=5173

# TerminusDB 连接（容器视角）
SCIWEAVE_MAPPING_TERMINUSDB_URL=http://host.docker.internal:6363
SCIWEAVE_MAPPING_TERMINUSDB_STORE=admin
SCIWEAVE_MAPPING_TERMINUSDB_DATABASE=sciweave_dashboard_demo
SCIWEAVE_MAPPING_TERMINUSDB_USERNAME=admin
# 本机固定容器的默认口令；换成真实实例时改这里，且不要提交真实值。
SCIWEAVE_MAPPING_TERMINUSDB_PASSWORD=root

# 看板展示的映射域
SCIWEAVE_MAPPING_DOMAIN_ID=iris-demo

# 看板来源令牌：留空表示不校验（仅本地）。设了值则请求必须带 Bearer。
SCIWEAVE_MAPPING_DASHBOARD_TOKEN=

# 浏览器实际访问页面时用的源，必须与 WEB_HOST_PORT 一致，否则 CORS 会拦。
SCIWEAVE_DASHBOARD_CORS_ORIGIN=http://127.0.0.1:5173

# 前端在浏览器里请求 dashboard-api 的地址（宿主机视角）
VITE_DASHBOARD_API_URL=http://127.0.0.1:8702/

# 可选：接上 queue 看板来源（见 ai4-nvuj），例如 http://host.docker.internal:8703/sources
SCIWEAVE_DASHBOARD_SOURCE_QUEUE_URL=
