# 中央服务单容器的环境变量样例。复制成 `.env` 再改，`.env` 不提交。
#
#   cp .env.example .env
#
# `compose.yaml` 用 `env-file` 把这些值注入容器，并对内部端口、路径和进程间
# 地址给出默认值——那些不需要你填。下面每一项都必须改的是**令牌**：本文件里的
# `change-me-*` 只是占位值，直接跑起来等于把中央服务的管理接口公开在可猜的令牌后面。
#
# 生成一组随机令牌（本机执行，粘回本文件即可）：
#
#   python -c "import secrets;print('\n'.join(f'{n}={secrets.token_urlsafe(24)}' for n in [
#     'CENTRE_TOKEN_MAP_AGENT','CENTRE_TOKEN_MAP_OWNER','CENTRE_TOKEN_WIKI_AGENT',
#     'CENTRE_TOKEN_WIKI_OWNER','CENTRE_TOKEN_CENTRE_AGENT','CENTRE_TOKEN_BUFFER',
#     'CENTRE_TOKEN_REGISTRY_OWNER','CENTRE_TOKEN_REGISTRY_RESEARCHER',
#     'CENTRE_TOKEN_REGISTRY_CENTRE','CENTRE_TOKEN_REGISTRY_EMAIL',
#     'CENTRE_TOKEN_EMAIL_WORKFLOW','CENTRE_TOKEN_EMAIL_OPS',
#     'CENTRE_TOKEN_COORDINATOR','CENTRE_TOKEN_GATEWAY','CENTRE_TOKEN_DASHBOARD_SOURCE']))"

# ---------------------------------------------------------------- 访问凭据
# 领域管理 MCP：端侧 Agent（dsh/workbuddy 上的套件）用 agent 令牌提交候选，
# PO 用自己的令牌审核与正式化，中央 Agent 用 centre 令牌读候选并写预审报告。
CENTRE_TOKEN_MAP_AGENT=change-me-map-agent
CENTRE_TOKEN_MAP_OWNER=change-me-map-owner
CENTRE_TOKEN_WIKI_AGENT=change-me-wiki-agent
CENTRE_TOKEN_WIKI_OWNER=change-me-wiki-owner
# 中央 Agent 一个令牌同时用于 research-map 与 research-wiki 的管理 MCP。
CENTRE_TOKEN_CENTRE_AGENT=change-me-centre-agent
# 草稿箱：端侧 Worker 写草稿用的令牌。
CENTRE_TOKEN_BUFFER=change-me-buffer
# Registry：PO / 研究员 / 中央服务 / 通知服务各自的令牌。
CENTRE_TOKEN_REGISTRY_OWNER=change-me-registry-owner
CENTRE_TOKEN_REGISTRY_RESEARCHER=change-me-registry-researcher
CENTRE_TOKEN_REGISTRY_CENTRE=change-me-registry-centre
CENTRE_TOKEN_REGISTRY_EMAIL=change-me-registry-email
# email-service：工作流提交通知、值班人查状态。
CENTRE_TOKEN_EMAIL_WORKFLOW=change-me-email-workflow
CENTRE_TOKEN_EMAIL_OPS=change-me-email-ops
# coordinator 自己的 MCP（PO 用它显式下发根任务）。
CENTRE_TOKEN_COORDINATOR=change-me-coordinator
# 中央 Agent Gateway MCP（处置面：query/list_pending/health 等）。
CENTRE_TOKEN_GATEWAY=change-me-gateway
# 看板内部来源的读取令牌（mapping / wiki / queue 三个来源共用）。
CENTRE_TOKEN_DASHBOARD_SOURCE=change-me-dashboard-source

# ---------------------------------------------------------------- 对外地址
# 浏览器打开看板时用的地址。dashboard-api 的 CORS 只允许这一个来源，
# 前端 bundle 里的 API 地址也是构建期确定的 `${VITE_DASHBOARD_API_URL}`。
# 部署到服务器后改成 http://<服务器地址>:8080。
SCIWEAVE_CENTRE_PUBLIC_ORIGIN=http://127.0.0.1:8080
# 前端的 API 基地址 = 浏览器能访问到的 dashboard-api。
VITE_DASHBOARD_API_URL=http://127.0.0.1:8702/

# ------------------------------------------------------- 第三方服务地址
# TerminusDB 与 Redpanda 按既有约定跑在宿主机（或另一个 compose 栈）上，
# 见 sci-weave/service/terminusdb 与 sci-weave/service/redpanda。
SCIWEAVE_MAPPING_TERMINUSDB_URL=http://host.docker.internal:6363
SCIWEAVE_MAPPING_TERMINUSDB_DATABASE=sciweave_mapping
SCIWEAVE_MAPPING_TERMINUSDB_STORE=admin
SCIWEAVE_MAPPING_TERMINUSDB_USERNAME=admin
SCIWEAVE_MAPPING_TERMINUSDB_PASSWORD=root

SCIWEAVE_WIKI_TERMINUSDB_URL=http://host.docker.internal:6363
SCIWEAVE_WIKI_TERMINUSDB_DATABASE=sciweave_wiki
SCIWEAVE_WIKI_TERMINUSDB_STORE=admin
SCIWEAVE_WIKI_TERMINUSDB_USERNAME=admin
SCIWEAVE_WIKI_TERMINUSDB_PASSWORD=root

SCIWEAVE_BUFFER_TERMINUSDB_URL=http://host.docker.internal:6363
SCIWEAVE_BUFFER_TERMINUSDB_DATABASE=sciweave_draft_domain
SCIWEAVE_BUFFER_TERMINUSDB_USERNAME=admin
SCIWEAVE_BUFFER_TERMINUSDB_PASSWORD=root

# 治理事件与任务交接共用的 broker（宿主机视角的 Kafka API 端口）。
SCIWEAVE_CENTRE_KAFKA_BOOTSTRAP=host.docker.internal:19092

# ---------------------------------------------------------------- 领域标识
# 一旦有正式版本，改这两个值等于换一个新的领域，不要随便动。
SCIWEAVE_MAPPING_DOMAIN_ID=iris-demo
SCIWEAVE_WIKI_DOMAIN_ID=sciweave-wiki

# ------------------------------------------------------------ 通知发件人
# email-service 必填。真实发信还要把下面四项 SMTP 配置**配全**，
# 只配一半会让进程拒绝启动（防止密码在 starttls 之前明文送出）。
SCIWEAVE_EMAIL_FROM_ADDRESS=no-reply@example.test

# SCIWEAVE_EMAIL_SMTP_HOST=smtp.example.test
# SCIWEAVE_EMAIL_SMTP_PORT=587
# SCIWEAVE_EMAIL_SMTP_USERNAME=mailbox-user
# SCIWEAVE_EMAIL_SMTP_PASSWORD=replace-with-smtp-password
# 必填且无默认值：ssl / starttls / none。猜错会把密码明文发出去。
# SCIWEAVE_EMAIL_SMTP_SECURITY=starttls

# ------------------------------------------------------------ Worker 模型
# 不配置也能起：gateway 会把 worker runtime 标成 misconfigured 并照常提供处置面，
# 只是执行记录不会真的跑模型。端侧执行主要由 dsh/workbuddy 上的套件承担。
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# SCIWEAVE_WORKER_MODEL=deepseek-chat
