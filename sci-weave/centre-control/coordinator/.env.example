SCIWEAVE_COORDINATOR_SQLITE_PATH=./coordinator.sqlite3
SCIWEAVE_COORDINATOR_RETRY_INITIAL_SECONDS=1
SCIWEAVE_COORDINATOR_RETRY_MULTIPLIER=2
SCIWEAVE_COORDINATOR_RETRY_MAX_SECONDS=60
SCIWEAVE_COORDINATOR_DISPATCH_POLL_SECONDS=1
SCIWEAVE_COORDINATOR_MAX_ATTEMPTS=3

# research-map 管理 MCP（正式快照读取，必填）
SCIWEAVE_MAPPING_MCP_ENDPOINT=http://127.0.0.1:8700/mcp
SCIWEAVE_MAPPING_MCP_TOKEN=change-me

# Registry MCP（执行者可用性，必填）
SCIWEAVE_REGISTRY_MCP_ENDPOINT=http://127.0.0.1:8701/mcp
SCIWEAVE_REGISTRY_MCP_TOKEN=change-me

# Redpanda（task_handoff_ready 发布，必填）
SCIWEAVE_COORDINATOR_KAFKA_BOOTSTRAP=127.0.0.1:9092

# email-service MCP（人工通知意图，可选；缺省时通知路径仅保留等待事实）
SCIWEAVE_EMAIL_MCP_ENDPOINT=http://127.0.0.1:8702/mcp
SCIWEAVE_EMAIL_MCP_TOKEN=change-me
