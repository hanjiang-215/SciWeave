# Central Draft Buffer; inject with uv run --env-file .env
SCIWEAVE_BUFFER_TERMINUSDB_URL=http://127.0.0.1:PORT
SCIWEAVE_BUFFER_TERMINUSDB_DATABASE=sciweave_draft_domain
SCIWEAVE_BUFFER_TERMINUSDB_USERNAME=
SCIWEAVE_BUFFER_TERMINUSDB_PASSWORD=
SCIWEAVE_BUFFER_TERMINUSDB_TOKEN=
SCIWEAVE_BUFFER_REQUEST_TIMEOUT_SECONDS=10
# JSON object; each namespace must list its authorized reviewer IDs.
SCIWEAVE_BUFFER_REVIEWERS_JSON={"mapping":["replace-with-mapping-reviewer"],"wiki":["replace-with-wiki-reviewer"]}
# Optional Streamable HTTP MCP endpoint. Configure both together; when set,
# the process serves MCP JSON-RPC at POST /mcp instead of stdio.
SCIWEAVE_BUFFER_MCP_HOST=127.0.0.1
SCIWEAVE_BUFFER_MCP_PORT=0
# Required when the MCP endpoint is enabled: token -> actor_id mapping.
SCIWEAVE_BUFFER_MCP_TOKENS_JSON={"replace-with-token":"replace-with-actor-id"}
