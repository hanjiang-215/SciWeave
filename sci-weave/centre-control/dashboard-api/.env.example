# Listen address and port are supplied by the deployment environment.
SCIWEAVE_DASHBOARD_HOST=127.0.0.1
SCIWEAVE_DASHBOARD_PORT=0
SCIWEAVE_DASHBOARD_SOURCE_TIMEOUT_SECONDS=5
# Total budget for one snapshot across all sources; a source still running when it
# expires is reported as unavailable instead of failing the whole snapshot.
SCIWEAVE_DASHBOARD_SNAPSHOT_DEADLINE_SECONDS=10
SCIWEAVE_DASHBOARD_SOURCE_MAX_BYTES=1048576
# Exact browser origin (scheme://host[:port], no path) allowed to call the API cross-origin.
# Required when the web UI is served from a different origin; leave blank for same-origin deployment.
SCIWEAVE_DASHBOARD_CORS_ORIGIN=

# Configure trusted, read-only source endpoints. Leave unready sources blank.
SCIWEAVE_DASHBOARD_SOURCE_MAPPING_URL=
SCIWEAVE_DASHBOARD_SOURCE_MAPPING_TOKEN=
SCIWEAVE_DASHBOARD_SOURCE_WIKI_URL=
SCIWEAVE_DASHBOARD_SOURCE_WIKI_TOKEN=
SCIWEAVE_DASHBOARD_SOURCE_GATEWAY_URL=
SCIWEAVE_DASHBOARD_SOURCE_GATEWAY_TOKEN=
SCIWEAVE_DASHBOARD_SOURCE_QUEUE_URL=
SCIWEAVE_DASHBOARD_SOURCE_QUEUE_TOKEN=
