SCIWEAVE_EMAIL_SQLITE_PATH=./email-delivery.sqlite3
SCIWEAVE_AUDIT_SQLITE_PATH=./email-audit.sqlite3
SCIWEAVE_EMAIL_HOST=127.0.0.1
SCIWEAVE_EMAIL_PORT=0
SCIWEAVE_EMAIL_ISSUER_URL=http://127.0.0.1/issuer
SCIWEAVE_EMAIL_RESOURCE_URL=http://127.0.0.1/email-service
SCIWEAVE_EMAIL_API_VERSION=1
SCIWEAVE_EMAIL_FROM_ADDRESS=public-mailbox@example.test
SCIWEAVE_EMAIL_SMTP_HOST=smtp.example.test
SCIWEAVE_EMAIL_SMTP_PORT=2525
SCIWEAVE_EMAIL_SMTP_USERNAME=mailbox-user
SCIWEAVE_EMAIL_SMTP_PASSWORD=example-not-a-secret
SCIWEAVE_EMAIL_TOKENS_JSON={"gateway-token":{"caller_id":"service:task-gateway","caller_type":"service"},"workflow-token":{"caller_id":"service:centre-workflow","caller_type":"service"}}
