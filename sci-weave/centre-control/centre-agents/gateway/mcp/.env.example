# Python 运行环境变量
SCIWEAVE_GATEWAY_TOKEN=replace-with-local-development-token
SCIWEAVE_GATEWAY_CALLER_ID=local-development-owner
SCIWEAVE_GATEWAY_DB=var/gateway.sqlite3
SCIWEAVE_GATEWAY_HOST=127.0.0.1
SCIWEAVE_GATEWAY_PORT=8080
# 可选：配置后启用不需要模型凭据的 fast-agent passthrough Worker。
SCIWEAVE_WORKER_HOME=var/worker-home
SCIWEAVE_WORKER_SESSION_DIR=sessions
# 必填：Worker 的 connection scope，缺省会让 WorkerSettings 校验失败、执行永远停在 queued。
SCIWEAVE_WORKER_CONNECTION_SCOPE=local
# 显式开关：没有模型凭据时才会启用写桩历史的 passthrough 运行时（默认关闭）。
SCIWEAVE_GATEWAY_PASSTHROUGH_RUNTIME=0
