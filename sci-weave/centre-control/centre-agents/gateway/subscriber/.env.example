# gateway/subscriber 角色专属环境变量示例。
# 真实值通过本机 `uv run --env-file .env` 注入，仓库不提交真实凭据。

# 订阅者身份与订阅目标（必填）
SCIWEAVE_AGENT_ID=task-agent-1
SCIWEAVE_SUBSCRIBER_TOPICS=sciweave.task-handoff.task-agent-1

# 队列客户端：bootstrap 与消费者组均配置时使用真实 Redpanda；
# 任一为空时退回 FakeQueueClient（仅本地演示/测试）。
SCIWEAVE_QUEUE_BOOTSTRAP_SERVERS=127.0.0.1:19092
SCIWEAVE_QUEUE_GROUP_ID=sciweave.task-workflow.demo.agent-1

# 共享 SQLite 与 Worker 配置（与 gateway/mcp 共用同一数据库文件）
SCIWEAVE_GATEWAY_DB=/path/to/centre.sqlite3
SCIWEAVE_WORKER_HOME=/path/to/worker-home
SCIWEAVE_WORKER_SESSION_DIR=sessions
SCIWEAVE_WORKER_CONNECTION_SCOPE=centre-agent-local

# 真实模型运行（可选）。不配置 API Key 时必须显式设置 SCIWEAVE_GATEWAY_PASSTHROUGH_RUNTIME=1 才会启用写桩历史的 passthrough runtime，否则启动即失败。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
SCIWEAVE_WORKER_MODEL=

# 中央草稿箱写入（可选；不配置则完成态不带 draft_id）
SCIWEAVE_DRAFT_BUFFER_ENDPOINT=http://127.0.0.1:PORT/mcp
SCIWEAVE_DRAFT_BUFFER_TOKEN=
SCIWEAVE_DRAFT_BUFFER_NAMESPACE=mapping
SCIWEAVE_DRAFT_BUFFER_SUBMITTER_ID=service:task-agent-1
SCIWEAVE_GATEWAY_PASSTHROUGH_RUNTIME=0
