# DeepSeek 官方 API。真实密钥只保存在本地 .env，禁止提交。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Worker 使用的 DeepSeek 模型。定义里写占位符
# `configure-in-your-own-environment` 的 agent 用它；写具体模型名的 agent 用自己的。
SCIWEAVE_WORKER_MODEL=deepseek-chat

# Worker 专属持久化目录及会话存放子目录。
SCIWEAVE_WORKER_HOME=var/worker-home
SCIWEAVE_WORKER_SESSION_DIR=sessions

# 同一中央 Agent 部署内的 Worker 连接域。
SCIWEAVE_WORKER_CONNECTION_SCOPE=centre-agent

# 跑哪个工作流。只有一个时可以不写；写错了是启动失败，不静默回落。
# SCIWEAVE_WORKFLOW=centre-prereview

# 定义层读的三处。不写就用 centre-agents/ 下的出厂目录；写了必须存在。
# CENTRE_DEFINITIONS_PATH=definitions
# CENTRE_MCP_LIBS_PATH=libs/mcp-libs
# CENTRE_RULES_DIR=rules

# 报告里记的判据版本。目录里只有一份时可以推断；多份时必须显式选。
# CENTRE_PREREVIEW_RULE_SET_VERSION=1.0.0

# MCP 卡片的 endpoint.url_env 指向这些变量。缺一个是启动失败。
# RESEARCH_MAPPING_MCP_URL=http://127.0.0.1:8710/mcp
# LLM_WIKI_MCP_URL=http://127.0.0.1:8720/mcp
# EMAIL_MCP_URL=http://127.0.0.1:8750/mcp
