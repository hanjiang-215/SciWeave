# LLM-Wiki 本地运行配置；仅提交变量名和占位值，不提交真实凭据。
SCIWEAVE_WIKI_SQLITE_PATH=./data/wiki.sqlite
SCIWEAVE_WIKI_DOMAIN_ID=replace-with-stable-wiki-domain-id
SCIWEAVE_WIKI_TERMINUSDB_URL=http://127.0.0.1:PORT
SCIWEAVE_WIKI_TERMINUSDB_DATABASE=replace-with-database
SCIWEAVE_WIKI_TERMINUSDB_STORE=replace-with-store
SCIWEAVE_WIKI_TERMINUSDB_TOKEN=
# 二选一：JWT 部署用 TOKEN；本机固定容器用 HTTP Basic（默认容器为 admin:root）。
SCIWEAVE_WIKI_TERMINUSDB_USERNAME=
SCIWEAVE_WIKI_TERMINUSDB_PASSWORD=
SCIWEAVE_WIKI_DASHBOARD_MODE=0
SCIWEAVE_WIKI_DASHBOARD_HOST=127.0.0.1
SCIWEAVE_WIKI_DASHBOARD_PORT=0
SCIWEAVE_WIKI_DASHBOARD_TOKEN=
# Optional management MCP (ai4-w73z). Configure host+port together; when set the
# process serves the wiki management MCP at POST /mcp instead of stdout print.
SCIWEAVE_WIKI_MCP_HOST=127.0.0.1
SCIWEAVE_WIKI_MCP_PORT=0
# Required when the management endpoint is enabled: token -> actor_id mapping.
SCIWEAVE_WIKI_MCP_TOKENS_JSON={"replace-with-token":"replace-with-actor-id"}
# Server-side capability tiers per actor; not client-declared roles.
SCIWEAVE_WIKI_CALLER_CAPABILITIES_JSON={"replace-with-actor-id":["read"]}
# Optional interface-layer audit SQLite path; when set the management MCP must
# open/init it on startup or fail to start.
SCIWEAVE_WIKI_AUDIT_SQLITE_PATH=
