# DeepSeek 官方 API。真实密钥只保存在本地 .env，禁止提交。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Worker 使用的 DeepSeek 模型。
SCIWEAVE_WORKER_MODEL=deepseek-chat

# Worker 专属持久化目录及会话存放子目录。
SCIWEAVE_WORKER_HOME=var/worker-home
SCIWEAVE_WORKER_SESSION_DIR=sessions

# 同一 Task Agent 部署内的 Worker 连接域。
SCIWEAVE_WORKER_CONNECTION_SCOPE=task-agent
