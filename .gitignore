sci-weave/centre-control/shared/*/uv.lock

# suitecheck 只有一个依赖（pyyaml），锁文件只会随本机镜像配置漂移，没有锁定的价值
sci-weave/toolkits/suitecheck/uv.lock

# 看板本地演示的运行态产物（SQLite 与进程登记，可再生成）
scripts/.demo-dashboard.json
sci-weave/centre-control/research-map/data/

# dsh/ 本地一键运行的运行态产物（数据、进程登记、日志、真实 .env 含令牌）
dsh/data/
dsh/pids/
dsh/logs/
dsh/.env
