{
  "version": 1,
  "hooks": {
    "afterShellExecution": [
      {
        "command": "python .cursor/hooks/ticket-index-sync.py after-shell",
        "matcher": "\\bfer\\b",
        "timeout": 60
      }
    ],
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/ticket-index-sync.py after-file-edit",
        "timeout": 60
      }
    ]
  }
}
